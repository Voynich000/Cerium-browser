# Ships uBlock Origin and Dark Reader in the Windows installer: the files that
# utils/bundle_extensions.py writes into the build output (bundled_extensions\
# and initial_preferences) go into the version directory, next to chrome.dll,
# where the browser looks for them (base::DIR_ASSETS; see
# patches/cerium/add-bundled-extensions.patch). Windows reads initial
# preferences next to chrome.exe, so the browser also looks for them there.
# (The portable .zip gets the same files from windows/package.py.)

--- a/chrome/browser/first_run/first_run_internal_win.cc
+++ b/chrome/browser/first_run/first_run_internal_win.cc
@@ -161,7 +161,17 @@
   if (!base::PathService::Get(base::DIR_EXE, &dir_exe))
     return base::FilePath();
 
-  return installer::InitialPreferences::Path(dir_exe);
+  base::FilePath initial_prefs = installer::InitialPreferences::Path(dir_exe);
+  // Then the defaults Cerium ships next to chrome.dll (in the version
+  // directory of an installation), which pin the bundled extensions.
+  base::FilePath dir_assets;
+  if (!base::PathExists(initial_prefs) &&
+      base::PathService::Get(base::DIR_ASSETS, &dir_assets)) {
+    base::FilePath bundled = installer::InitialPreferences::Path(dir_assets);
+    if (base::PathExists(bundled))
+      return bundled;
+  }
+  return initial_prefs;
 }
 
 }  // namespace internal
--- a/chrome/installer/mini_installer/chrome.release
+++ b/chrome/installer/mini_installer/chrome.release
@@ -43,6 +43,14 @@
 #
 Extensions\*.*: %(VersionDir)s\Extensions\
 locales\*.pak: %(VersionDir)s\Locales
+#
+# Cerium: the extensions that ship with the browser (uBlock Origin, Dark
+# Reader) and the initial preferences that pin them, next to chrome.dll, where
+# the browser looks for them (base::DIR_ASSETS).
+#
+bundled_extensions\*.*: %(VersionDir)s\bundled_extensions\
+bundled_extensions\licenses\*.*: %(VersionDir)s\bundled_extensions\licenses\
+initial_preferences: %(VersionDir)s\
 
 #
 # VisualElements sub-dir.
