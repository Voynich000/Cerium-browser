# Gives Cerium its own Windows identity, so it never shares anything with an
# installed Chromium: the install and profile folders (%LOCALAPPDATA%\Cerium),
# the registry key (Software\Cerium), the app ID used by the taskbar and the
# default-apps settings, the HTML/PDF file type and cerium:// registrations,
# new class IDs for the COM servers it registers (toast notifications,
# elevation and tracing services), a new Active Setup GUID and a new sandbox
# AppContainer SID prefix. The interface IDs stay: they name the interfaces
# defined in the IDL files, not the product.

--- a/chrome/install_static/chromium_install_modes.h
+++ b/chrome/install_static/chromium_install_modes.h
@@ -21,7 +21,7 @@
 
 // The brand-specific product name to be included as a component of the install
 // and user data directory paths.
-inline constexpr wchar_t kProductPathName[] = L"Chromium";
+inline constexpr wchar_t kProductPathName[] = L"Cerium";
 
 // The brand-specific safe browsing client name.
 inline constexpr char kSafeBrowsingName[] = "chromium";
@@ -54,28 +54,31 @@
