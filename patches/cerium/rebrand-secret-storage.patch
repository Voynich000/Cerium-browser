# Gives Cerium its own entry in the system's secret store, which holds the key
# that encrypts saved passwords and cookies: "Cerium Safe Storage" in the macOS
# keychain and in the Linux Secret Service/KWallet, instead of Chromium's.
# Otherwise Cerium would share the key with any installed Chromium, and macOS
# would ask the user to allow Cerium access to Chromium's keychain item. This
# has to stay the same from the first release on: a different name means a new
# key, and data encrypted with the old one can no longer be read.

--- a/components/os_crypt/async/browser/freedesktop_secret_key_provider.h
+++ b/components/os_crypt/async/browser/freedesktop_secret_key_provider.h
@@ -158,9 +158,9 @@
   static constexpr char kKeyName[] = "Chrome Safe Storage";
   static constexpr char kAppName[] = "chrome";
 #else
-  static constexpr char kKWalletFolder[] = "Chromium Keys";
-  static constexpr char kKeyName[] = "Chromium Safe Storage";
-  static constexpr char kAppName[] = "chromium";
+  static constexpr char kKWalletFolder[] = "Cerium Keys";
+  static constexpr char kKeyName[] = "Cerium Safe Storage";
+  static constexpr char kAppName[] = "cerium";
 #endif
 
   void InitializeFreedesktopSecretService();
--- a/components/os_crypt/common/keychain_password_mac.mm
+++ b/components/os_crypt/common/keychain_password_mac.mm
@@ -35,8 +35,8 @@
 const char kDefaultServiceName[] = "Chrome Safe Storage";
 const char kDefaultAccountName[] = "Chrome";
 #else
-const char kDefaultServiceName[] = "Chromium Safe Storage";
-const char kDefaultAccountName[] = "Chromium";
+const char kDefaultServiceName[] = "Cerium Safe Storage";
+const char kDefaultAccountName[] = "Cerium";
 #endif
 
 // These values are persisted to logs. Entries should not be renumbered and
