-        return URLPattern(URLPattern::SCHEME_ALL, pattern).MatchesURL(url);
+        URLPattern url_pattern(URLPattern::SCHEME_ALL, pattern);
+        if (url_pattern.MatchesURL(url)) {
+          return true;
+        }
+        // Patterns for Google sites were renamed by domain substitution.
+        // Match them against the real hosts while Google services are on.
+        if (!net::IsGoogleServicesEnabled()) {
+          return false;
+        }
+        std::optional<std::string> host =
+            net::UnsubstituteHost(url_pattern.host());
+        if (!host) {
+          return false;
+        }
+        url_pattern.SetHost(*host);
+        return url_pattern.MatchesURL(url);
       });
 }
 
