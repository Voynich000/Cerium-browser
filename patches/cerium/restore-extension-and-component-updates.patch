# With Google services on, restores extension update checks
# (disable-webstore-urls.patch) and component updater checks such as the
# Widevine CDM and security lists (block-requests.patch).

--- a/components/update_client/BUILD.gn
+++ b/components/update_client/BUILD.gn
@@ -184,6 +184,7 @@ static_library("update_client") {
     "//components/version_info",
     "//components/zucchini:zucchini_lib",
     "//crypto",
+    "//net",
     "//third_party/zlib/google:compression_utils",
     "//url",
   ]
--- a/components/update_client/update_checker.cc
+++ b/components/update_client/update_checker.cc
@@ -39,6 +39,7 @@
 #include "components/update_client/update_client.h"
 #include "components/update_client/update_engine.h"
 #include "components/update_client/utils.h"
+#include "net/base/google_services_toggle.h"
 #include "url/gurl.h"
 
 namespace update_client {
@@ -104,7 +105,10 @@ void UpdateCheckerImpl::CheckForUpdates(
     scoped_refptr<UpdateContext> context,
     const base::flat_map<std::string, std::string>& additional_attributes,
     UpdateCheckCallback update_check_callback) {
-  return;
+  // Component and extension updates only run with Google services turned on.
+  if (!net::IsGoogleServicesEnabled()) {
+    return;
+  }
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
 
   update_check_callback_ = std::move(update_check_callback);
--- a/extensions/browser/updater/extension_downloader.cc
+++ b/extensions/browser/updater/extension_downloader.cc
@@ -42,6 +42,7 @@
 #include "extensions/common/extension_urls.h"
 #include "extensions/common/verifier_formats.h"
 #include "net/base/backoff_entry.h"
+#include "net/base/google_services_toggle.h"
 #include "net/base/load_flags.h"
 #include "net/base/net_errors.h"
 #include "net/http/http_status_code.h"
@@ -158,6 +159,9 @@ std::optional<GURL> SanitizeUpdateURL(const ExtensionId& extension_id,
                                       const GURL& update_url) {
   if (update_url.is_empty()) {
     // Fill in default update URL.
+    if (net::IsGoogleServicesEnabled()) {
+      return extension_urls::GetWebstoreUpdateUrl();
+    }
     return std::nullopt;
   }
 
@@ -176,6 +180,12 @@ std::optional<GURL> SanitizeUpdateURL(const ExtensionId& extension_id,
     return std::nullopt;
   }
 
+  // Make sure we use SSL for store-hosted extensions.
+  if (net::IsGoogleServicesEnabled() &&
+      extension_urls::IsWebstoreUpdateUrl(update_url) &&
+      !update_url.SchemeIsCryptographic()) {
+    return extension_urls::GetWebstoreUpdateUrl();
+  }
 
   return update_url;
 }
@@ -347,6 +357,14 @@ void ExtensionDownloader::DoStartAllPending() {
     AddToFetches(fetches_preparing, std::move(task));
   pending_tasks_.clear();
 
+  // Extension update checks only run with Google services turned on.
+  if (!net::IsGoogleServicesEnabled()) {
+    return;
+  }
+  for (auto& fetch_list : fetches_preparing) {
+    for (auto& fetch : fetch_list.second)
+      StartUpdateCheck(std::move(fetch));
+  }
 }
 
