# Installs the extensions in <install dir>/bundled_extensions (uBlock Origin
# and Dark Reader, see utils/bundle_extensions.py) on every platform, without
# the external-extension prompt. They stay user-manageable and are updated
# together with the browser.

--- a/chrome/browser/extensions/external_provider_impl.cc
+++ b/chrome/browser/extensions/external_provider_impl.cc
@@ -874,6 +874,20 @@ void ExternalProviderImpl::CreateExternalProviders(
 
 #endif  // BUILDFLAG(IS_CHROMEOS)
   if (!profile->GetPrefs()->GetBoolean(pref_names::kBlockExternalExtensions)) {
+    // Extensions that ship with the browser (uBlock Origin and Dark Reader),
+    // described by <id>.json files in DIR_BUNDLED_EXTENSIONS that point at
+    // .crx files next to them. They install without the external-extension
+    // prompt on every platform, stay user-manageable (removing one is
+    // remembered) and are updated together with the browser.
+    auto bundled_provider = std::make_unique<ExternalProviderImpl>(
+        service,
+        base::MakeRefCounted<ExternalPrefLoader>(
+            chrome::DIR_BUNDLED_EXTENSIONS, ExternalPrefLoader::NONE, nullptr),
+        profile, ManifestLocation::kExternalPref,
+        ManifestLocation::kExternalPrefDownload, Extension::NO_FLAGS);
+    bundled_provider->set_auto_acknowledge(true);
+    provider_list->push_back(std::move(bundled_provider));
+
 #if BUILDFLAG(IS_LINUX)
     provider_list->push_back(std::make_unique<ExternalProviderImpl>(
         service,
--- a/chrome/common/chrome_paths.cc
+++ b/chrome/common/chrome_paths.cc
@@ -447,6 +447,15 @@ bool PathProvider(int key, base::FilePath* result) {
 #endif
       break;
 
+    case chrome::DIR_BUNDLED_EXTENSIONS:
+      // Next to the executable on Linux and Windows, in the framework's
+      // resources on macOS.
+      if (!base::PathService::Get(base::DIR_ASSETS, &cur)) {
+        return false;
+      }
+      cur = cur.Append(FILE_PATH_LITERAL("bundled_extensions"));
+      break;
+
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE) &&                                   \
     (BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_MAC) || \
      BUILDFLAG(IS_ANDROID))
--- a/chrome/common/chrome_paths.h
+++ b/chrome/common/chrome_paths.h
@@ -71,6 +71,8 @@ enum {
                                        // installed when chrome is run.
 #endif
   DIR_EXTERNAL_EXTENSIONS,  // Directory where installer places .crx files.
+  DIR_BUNDLED_EXTENSIONS,   // Directory with the .crx and .json files of the
+                            // extensions that ship with the browser.
 
   FILE_LOCAL_STATE,      // Path and filename to the file in which
                          // machine/installation-specific state is saved.
