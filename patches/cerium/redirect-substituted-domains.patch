# With Google services on, requests to hosts renamed by domain substitution
# (e.g. clients2.9oo91e.qjz9zk) are redirected to the real host instead of
# being blocked by the trk: handler from block-trk-and-subdomains.patch.

--- a/net/url_request/trk_protocol_handler.cc
+++ b/net/url_request/trk_protocol_handler.cc
@@ -4,9 +4,16 @@
 
 #include "net/url_request/trk_protocol_handler.h"
 
+#include <string_view>
+
 #include "base/logging.h"
+#include "net/base/google_services_toggle.h"
 #include "net/base/net_errors.h"
+#include "net/url_request/redirect_util.h"
+#include "net/url_request/url_request.h"
 #include "net/url_request/url_request_error_job.h"
+#include "net/url_request/url_request_redirect_job.h"
+#include "url/gurl.h"
 
 namespace net {
 
@@ -14,6 +21,19 @@ TrkProtocolHandler::TrkProtocolHandler() = default;
 
 std::unique_ptr<URLRequestJob> TrkProtocolHandler::CreateJob(
     URLRequest* request) const {
+  if (IsGoogleServicesEnabled()) {
+    // URLRequest wrapped the substituted URL as "trk:<url>". Send the request
+    // to the real host instead of failing it.
+    std::string_view spec = request->url().possibly_invalid_spec();
+    GURL substituted_url(spec.substr(spec.find(':') + 1));
+    GURL target = UnsubstituteURL(substituted_url);
+    if (target != substituted_url && target.SchemeIsHTTPOrHTTPS()) {
+      return std::make_unique<URLRequestRedirectJob>(
+          request, target,
+          RedirectUtil::ResponseCode::REDIRECT_307_TEMPORARY_REDIRECT,
+          "Google services enabled");
+    }
+  }
   LOG(ERROR) << "Blocked URL in TrkProtocolHandler: " << request->original_url();
   return std::make_unique<URLRequestErrorJob>(request, ERR_BLOCKED_BY_CLIENT);
 }
--- a/net/url_request/url_request.cc
+++ b/net/url_request/url_request.cc
@@ -23,6 +23,7 @@
 #include "base/values.h"
 #include "net/base/auth.h"
 #include "net/base/features.h"
+#include "net/base/google_services_toggle.h"
 #include "net/base/io_buffer.h"
 #include "net/base/load_flags.h"
 #include "net/base/load_timing_info.h"
@@ -674,7 +675,9 @@ URLRequest::URLRequest(base::PassKey<URLRequestContext> pass_key,
 
   if (!url.SchemeIs(url::kTraceScheme) &&
       base::EndsWith(url.host(), "qjz9zk", base::CompareCase::INSENSITIVE_ASCII)) {
-    LOG(ERROR) << "Block URL in URLRequest: " << url;
+    if (!IsGoogleServicesEnabled()) {
+      LOG(ERROR) << "Block URL in URLRequest: " << url;
+    }
     url_chain_[0] = GURL(url::kTraceScheme + (":" + url.possibly_invalid_spec()));
   }
 
