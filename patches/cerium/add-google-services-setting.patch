       "hardwareAccelerationEnabledAtStartup",
       g_browser_process->gpu_mode_manager()->initial_gpu_mode_pref());
+
+  // Google services switch. The pref is applied at startup, so the page
+  // offers a relaunch while it differs from the running state.
+  data_source->AddBoolean("googleServicesEnabledAtStartup",
