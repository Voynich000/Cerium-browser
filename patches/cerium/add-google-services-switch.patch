+// Copyright 2026 The Cerium Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/base/domain_unsubstitution.h"
+
+#include <optional>
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace net {
+namespace {
+
+// The substituted names are what domain_regex.list produces; the expected
+// originals are spelled in pieces so domain substitution leaves them alone.
+TEST(DomainUnsubstitutionTest, ReversesEachRule) {
+  const struct {
+    const char* substituted;
+    std::string original;
+  } kCases[] = {
+      {"f0ntz.9oo91e8p1.qjz9zk", std::string("fonts.googleapis") + ".com"},
+      {"clients2.9oo91e.qjz9zk", std::string("clients2.google") + ".com"},
+      {"update.9oo91eapis.qjz9zk", std::string("update.googleapis") + ".com"},
+      {"chromewebstore.9oo91e.qjz9zk",
+       std::string("chromewebstore.google") + ".com"},
+      {"www.95tat1c.qjz9zk", std::string("www.gstatic") + ".com"},
+      {"ch40me.qjz9zk", std::string("chrome") + ".com"},
+      {"dev.ch40m1um.qjz9zk", std::string("dev.chromium") + ".org"},
+      {"m0z111a.qjz9zk", std::string("mozilla") + ".org"},
+      {"www.f8c3b00k.qjz9zk", std::string("www.facebook") + ".com"},
+      {"x.8pp2p8t.qjz9zk", std::string("x.appspot") + ".com"},
+      {"y0u1ub3-nocookie.qjz9zk", std::string("youtube-nocookie") + ".com"},
+      {"i.yt1mg.qjz9zk", std::string("i.ytimg") + ".com"},
+      {"mail.9ma1l.qjz9zk", std::string("mail.gmail") + ".com"},
+      {"ad.60u613cl1c4.n3t.qjz9zk", std::string("ad.doubleclick") + ".net"},
+      {"ad.60u613cl1c4.c0m.qjz9zk", std::string("ad.doubleclick") + ".com"},
+      {"proxy.9oo91e21p.qjz9zk", std::string("proxy.googlezip") + ".net"},
+      {"b3ac0n2.9vt1.qjz9zk", std::string("beacons.gvt1") + ".com"},
+      {"b3ac0n25.9vt2.qjz9zk", std::string("beacons5.gvt2") + ".com"},
+      {"lh3.99pht.qjz9zk", std::string("lh3.ggpht") + ".com"},
+      {"www.m1cr050ft.qjz9zk", std::string("www.microsoft") + ".com"},
+      {"l3lOO.qjz9zk", std::string("1e100") + ".net"},
+      {"developer.8n6r01d.qjz9zk", std::string("developer.android") + ".com"},
+      {"goo" ".gl.qjz9zk", std::string("goo") + ".gl"},
+      {"goo" ".gle.qjz9zk", std::string("goo") + ".gle"},
+      {"pr1v4cy54ndb0x.qjz9zk", std::string("privacysandbox") + ".com"},
+  };
+  for (const auto& test_case : kCases) {
+    EXPECT_EQ(test_case.original, UnsubstituteHost(test_case.substituted))
+        << test_case.substituted;
+  }
+}
+
+TEST(DomainUnsubstitutionTest, IsCaseInsensitive) {
+  EXPECT_EQ(std::string("clients2.google") + ".com",
+            UnsubstituteHost("CLIENTS2.9OO91E.QJZ9ZK"));
+}
+
+TEST(DomainUnsubstitutionTest, HandlesSeveralSubstitutions) {
+  EXPECT_EQ(std::string("www.google") + ".com.google" + ".com",
+            UnsubstituteHost("www.9oo91e.qjz9zk.9oo91e.qjz9zk"));
+}
+
+TEST(DomainUnsubstitutionTest, IgnoresOtherHosts) {
+  EXPECT_EQ(std::nullopt, UnsubstituteHost(""));
+  EXPECT_EQ(std::nullopt, UnsubstituteHost("qjz9zk"));
+  EXPECT_EQ(std::nullopt, UnsubstituteHost(".qjz9zk"));
+  EXPECT_EQ(std::nullopt, UnsubstituteHost("example.qjz9zk"));
+  EXPECT_EQ(std::nullopt, UnsubstituteHost("example.com"));
+  EXPECT_EQ(std::nullopt, UnsubstituteHost("www.9oo91e.qjz9zk.au"));
+  // Capture groups only accept what the forward rules can produce.
+  EXPECT_EQ(std::nullopt, UnsubstituteHost("9oo91e1.qjz9zk"));
+  EXPECT_EQ(std::nullopt, UnsubstituteHost("b3ac0n20.9vt1.qjz9zk"));
+}
+
