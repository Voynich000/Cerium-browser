+// Copyright 2026 The Cerium Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "net/base/domain_unsubstitution.h"
+
+#include <array>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+
+namespace net {
+
+namespace {
+
+// Every substituted domain ends up under this made-up TLD.
+constexpr std::string_view kSubstitutedTld = ".qjz9zk";
+
+// Written in two pieces so that domain substitution does not rewrite it.
+constexpr std::string_view kGooGl = "goo" ".gl";
+
+// What a capture group of a domain_regex.list rule can contain once the
+// domain is part of a canonical (lower case) hostname.
+enum class Group {
+  kNone,           // The rule has no capture group here.
+  kLabelChars,     // ([A-Za-z\-]*?\\*?)  ->  [a-z-]*
+  kOptionalDigit,  // ([1-9]?\\*?)        ->  [1-9]?
+  kOptionalE,      // (e?)                ->  e?
+};
+
+// A domain_regex.list rule, read backwards. Domain substitution turns
+//   <original_a><group1><original_b><group2><original_c>
+// into
+//   <substituted_a><group1><substituted_b><group2>.qjz9zk
+struct Rule {
+  std::string_view substituted_a;
+  Group group1;
+  std::string_view substituted_b;
+  Group group2;
+  std::string_view original_a;
+  std::string_view original_b;
+  std::string_view original_c;
+};
+
+// Same order as domain_regex.list. The original names are split into pieces
+// so that domain substitution itself never rewrites this table.
+constexpr auto kRules = std::to_array<Rule>({
+    {"f0ntz.9oo91e8p1", Group::kNone, "", Group::kNone, "fonts.googleapis", "",
+     ".com"},
+    {"9oo91e", Group::kLabelChars, "", Group::kNone, "google", "", ".com"},
+    {"95tat1c", Group::kLabelChars, "", Group::kNone, "gstatic", "", ".com"},
+    {"ch40me", Group::kLabelChars, "", Group::kNone, "chrome", "", ".com"},
+    {"ch40m1um", Group::kLabelChars, "", Group::kNone, "chromium", "", ".org"},
+    {"m0z111a", Group::kLabelChars, "", Group::kNone, "mozilla", "", ".org"},
+    {"f8c3b00k", Group::kLabelChars, "", Group::kNone, "facebook", "", ".com"},
+    {"8pp2p8t", Group::kLabelChars, "", Group::kNone, "appspot", "", ".com"},
+    {"y0u1ub3", Group::kLabelChars, "", Group::kNone, "youtube", "", ".com"},
+    {"yt1mg", Group::kLabelChars, "", Group::kNone, "ytimg", "", ".com"},
+    {"9ma1l", Group::kLabelChars, "", Group::kNone, "gmail", "", ".com"},
+    {"60u613cl1c4", Group::kLabelChars, ".n3t", Group::kNone, "doubleclick",
+     "", ".net"},
+    {"60u613cl1c4", Group::kLabelChars, ".c0m", Group::kNone, "doubleclick",
+     "", ".com"},
+    {"9oo91e21p", Group::kNone, "", Group::kNone, "googlezip", "", ".net"},
+    {"b3ac0n2", Group::kOptionalDigit, ".9vt", Group::kOptionalDigit,
+     "beacons", ".gvt", ".com"},
+    {"99pht", Group::kNone, "", Group::kNone, "ggpht", "", ".com"},
+    {"m1cr050ft", Group::kNone, "", Group::kNone, "microsoft", "", ".com"},
+    // The replacement is "l3lOO"; hosts are canonicalized to lower case.
+    {"l3loo", Group::kNone, "", Group::kNone, "1e100", "", ".net"},
+    {"8n6r01d", Group::kNone, "", Group::kNone, "android", "", ".com"},
+    {kGooGl, Group::kOptionalE, "", Group::kNone, kGooGl, "", ""},
+    {"pr1v4cy54ndb0x", Group::kLabelChars, "", Group::kNone, "privacysandbox",
+     "", ".com"},
+});
+
+bool IsLabelChar(char c) {
+  return (c >= 'a' && c <= 'z') || c == '-';
+}
+
+// Returns the length of the longest prefix of |text| that |group| can match.
+// Every shorter length is a valid match too.
+size_t MaxGroupLength(Group group, std::string_view text) {
+  if (group == Group::kLabelChars) {
+    size_t length = 0;
+    while (length < text.size() && IsLabelChar(text[length])) {
+      ++length;
+    }
+    return length;
+  }
+  if (text.empty()) {
+    return 0;
+  }
+  if (group == Group::kOptionalDigit) {
+    return text[0] >= '1' && text[0] <= '9' ? 1 : 0;
+  }
+  if (group == Group::kOptionalE) {
+    return text[0] == 'e' ? 1 : 0;
+  }
+  return 0;  // Group::kNone
+}
+
+// Tries to match |rule| against all of |tail|, which starts with the rule's
+// substituted_a. On success returns the original text for |tail|.
+std::optional<std::string> MatchRule(const Rule& rule, std::string_view tail) {
+  std::string_view after_a = tail.substr(rule.substituted_a.size());
+  const size_t max_group1 = MaxGroupLength(rule.group1, after_a);
+  for (size_t group1_length = 0; group1_length <= max_group1;
+       ++group1_length) {
+    std::string_view rest = after_a.substr(group1_length);
+    if (!rest.starts_with(rule.substituted_b)) {
+      continue;
+    }
+    std::string_view group2 = rest.substr(rule.substituted_b.size());
+    if (MaxGroupLength(rule.group2, group2) != group2.size()) {
+      continue;
+    }
+    std::string original(rule.original_a);
+    original.append(after_a.substr(0, group1_length));
+    original.append(rule.original_b);
+    original.append(group2);
+    original.append(rule.original_c);
+    return original;
+  }
+  return std::nullopt;
+}
+
+// Reverses the substitution that ends at the end of |name|, which is the text
+// before a ".qjz9zk". Like the regular expressions, uses the leftmost match.
+std::optional<std::string> UnsubstituteName(std::string_view name) {
+  for (const Rule& rule : kRules) {
+    for (size_t pos = name.find(rule.substituted_a);
+         pos != std::string_view::npos;
+         pos = name.find(rule.substituted_a, pos + 1)) {
+      std::optional<std::string> original = MatchRule(rule, name.substr(pos));
+      if (original) {
+        return std::string(name.substr(0, pos)) + *original;
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+std::optional<std::string> UnsubstituteHost(std::string_view host) {
+  const std::string lower_host = base::ToLowerASCII(host);
+  std::string_view rest = lower_host;
+  if (!rest.ends_with(kSubstitutedTld)) {
+    return std::nullopt;
+  }
+
+  // Usually there is one substituted name, but a host can contain several
+  // (e.g. "google.com.google.com"). Each of them ends before a ".qjz9zk".
+  std::string result;
+  while (!rest.empty()) {
+    const size_t end = rest.find(kSubstitutedTld);
+    std::optional<std::string> original = UnsubstituteName(rest.substr(0, end));
+    if (!original) {
+      return std::nullopt;
+    }
+    result.append(*original);
+    rest.remove_prefix(end + kSubstitutedTld.size());
+  }
+  return result;
+}
+
+}  // namespace net
