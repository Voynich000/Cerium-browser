+// Copyright 2026 The Cerium Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_BASE_GOOGLE_SERVICES_TOGGLE_H_
+#define NET_BASE_GOOGLE_SERVICES_TOGGLE_H_
+
+#include "base/feature_list.h"
+#include "net/base/net_export.h"
+
+class GURL;
+
+namespace net {
+
+// Master switch for the Google integrations that ungoogled-chromium removes
+// and Cerium can restore at runtime: Chrome Web Store installs, extension and
+// component updates (e.g. the Widevine CDM) and spell-check dictionary
+// downloads. While it is enabled, requests to hosts renamed by domain
+// substitution are redirected to the real hosts instead of being blocked.
+//
+// Disabled by default, which is exactly ungoogled-chromium's behaviour. Users
+// turn it on in chrome://settings/system; the "google_services.enabled"
+// local-state pref is applied when the FeatureList is created, so a change
+// takes effect after a relaunch. --enable-features=GoogleServices and
+// --disable-features=GoogleServices override the pref.
+NET_EXPORT BASE_DECLARE_FEATURE(kGoogleServices);
+
+// Returns whether kGoogleServices is enabled. Unlike a direct
+// base::FeatureList::IsEnabled() call it may be used before the FeatureList
+// exists (e.g. very early in startup), in which case it returns false.
+NET_EXPORT bool IsGoogleServicesEnabled();
+
+// Returns |url| with its host passed through UnsubstituteHost(), or |url|
+// itself if the host was not renamed by domain substitution.
+NET_EXPORT GURL UnsubstituteURL(const GURL& url);
+
+// Returns UnsubstituteURL(url) while Google services are enabled, and |url|
+// unchanged otherwise.
+NET_EXPORT GURL MaybeUnsubstituteURL(const GURL& url);
+
+}  // namespace net
+
+#endif  // NET_BASE_GOOGLE_SERVICES_TOGGLE_H_
