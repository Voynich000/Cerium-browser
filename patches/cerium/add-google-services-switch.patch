+// Copyright 2026 The Cerium Browser Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef NET_BASE_DOMAIN_UNSUBSTITUTION_H_
+#define NET_BASE_DOMAIN_UNSUBSTITUTION_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "net/base/net_export.h"
+
+namespace net {
+
+// ungoogled-chromium's domain substitution (domain_regex.list) rewrites Google
+// and a few other domain names in the source code into unresolvable names
+// under the made-up "qjz9zk" TLD, e.g.
+//
+//   clients2.google.com   -> clients2.9oo91e.qjz9zk
+//   update.googleapis.com -> update.9oo91eapis.qjz9zk
+//   fonts.googleapis.com  -> f0ntz.9oo91e8p1.qjz9zk
+//
+// UnsubstituteHost() reverses that mapping for a single hostname. Matching is
+// ASCII case-insensitive (GURL lower-cases hosts) and the result is lower
+// case. Returns std::nullopt if |host| is not a substituted hostname.
+//
+// The reverse rules must be kept in sync with domain_regex.list; Cerium's
+// utils/check_domain_unsubstitution.py verifies this.
+NET_EXPORT std::optional<std::string> UnsubstituteHost(std::string_view host);
+
+}  // namespace net
+
+#endif  // NET_BASE_DOMAIN_UNSUBSTITUTION_H_
